---
---
BEGIN:VCARD
VERSION:4.0
N:{{ site.author.family_name }};{{ site.author.given_name }};;;
{% include vcard-line.txt property="FN:" value=site.author.name %}
{% if site.tagline %}{% include vcard-line.txt property="TITLE:" value=site.tagline %}
{% endif %}{% if site.contact.email %}{% include vcard-line.txt property="EMAIL:" value=site.contact.email %}
{% endif %}{% assign u = site.url | append: "/" %}{% include vcard-line.txt property="URL:" value=u %}
{% if site.contact.signal %}{% include vcard-line.txt property="IMPP:" value=site.contact.signal.url %}
{% endif %}{% if site.contact.whatsapp %}{% include vcard-line.txt property="IMPP:" value=site.contact.whatsapp.url %}
{% endif %}END:VCARD

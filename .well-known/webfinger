{%- comment -%} WebFinger (RFC 7033) for this site's domain: a fediverse search for any
address @ this domain finds the Mastodon account in cv.yaml. The subject names
that account, so Mastodon then checks it with the account's own server, which
stays the account's authoritative WebFinger. As a static file it can't read
the ?resource= query, so every address gets this one answer {%- endcomment -%}
{%- if site.mastodon -%}
{%- assign account = site.mastodon -%}
{%- assign user = account | split: "@" | first -%}
{%- assign host = account | split: "@" | last -%}
{"subject":"acct:{{ account }}","aliases":["https://{{ host }}/@{{ user }}","https://{{ host }}/users/{{ user }}"],"links":[{"rel":"http://webfinger.net/rel/profile-page","type":"text/html","href":"https://{{ host }}/@{{ user }}"},{"rel":"self","type":"application/activity+json","href":"https://{{ host }}/users/{{ user }}"},{"rel":"http://ostatus.org/schema/1.0/subscribe","template":"https://{{ host }}/authorize_interaction?uri={uri}"}]}
{%- endif %}
